    "dev": "tsup --watch",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:run": "npm test",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "example:terminal": "tsx examples/terminal-chat/index.ts",
    "kaios": "tsx src/llm/cli.ts",
    "check": "npm run typecheck && npm run build && npm test && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "example:expression": "node examples/expression.mjs",
    "example:affect": "node examples/affect.mjs",
    "example:language": "node examples/language.mjs"
